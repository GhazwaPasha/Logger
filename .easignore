# What EAS Build uploads for the mobile app (apps/mobile). In this monorepo EAS packs the whole repository, and
# when this file exists it is used *instead of* .gitignore — so it repeats every secret / build-output rule from
# there, and also leaves out everything the Android build doesn't need.

# Dependencies and caches (EAS installs its own)
node_modules/
.expo/
.next/
.turbo/
dist/
*.tsbuildinfo
*.log
.DS_Store

# Local env files and credentials — never uploaded
.env
.env.*
test-credentials.local.txt
/eas credentials/
/credentials/
client_secret_*.json
client_*.apps.googleusercontent.com.plist
*service-account*.json
*firebase-adminsdk*.json

# Signing keys (EAS holds the app's keystore)
*.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*keystore-password*.txt
*.idsig

# Local builds: generated native projects (EAS runs prebuild itself) and release outputs
apps/mobile/android/
apps/mobile/ios/
/releases/
*.apk
*.aab
.gradle/
.kotlin/
*.hprof

# Not part of the mobile build: the other apps' sources. Their package.json files stay, because installing an npm
# workspace needs every workspace's manifest (and the root package-lock.json).
apps/web/*
!apps/web/package.json
apps/api/*
!apps/api/package.json

# Repo tooling, notes and design files
design/
docs/
second-memory/
.cursor/
.claude/
.agents/
skills-lock.json
render.yaml
