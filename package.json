{
  "name": "work-ledger",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:api": "npm run build -w @work-ledger/api",
    "start:api": "npm run start -w @work-ledger/api",
    "build:web": "npm run build -w @work-ledger/db && npm run build -w @work-ledger/contracts && npm run build -w @work-ledger/web",
    "build": "npm run build -ws --if-present",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @work-ledger/api",
    "dev:web": "npm run dev -w @work-ledger/web",
    "dev:mobile": "npm run start -w @work-ledger/mobile",
    "db:generate": "npm run generate -w @work-ledger/db",
    "db:migrate": "npm run migrate -w @work-ledger/db",
    "db:studio": "npm run studio -w @work-ledger/db",
    "db:seed": "npm run seed -w @work-ledger/db",
    "lint": "npm run lint -ws --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
