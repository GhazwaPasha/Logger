# Optional overrides. In development the app finds the local servers on its own
# (web/auth on :3000, API on :4000, on the same machine that runs Metro).
# In release builds it uses the production URLs from src/lib/config.ts.
#EXPO_PUBLIC_AUTH_URL=https://log-base.vercel.app
#EXPO_PUBLIC_API_URL=https://logger-emfz.onrender.com
