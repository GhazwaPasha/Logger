# Neon Postgres — paste from Dashboard → Connect, or after `npx neonctl@latest init`
# Direct (non-pooler) URL works for Drizzle migrate, Nest, and Better Auth (pg Pool).
# Pooled (-pooler host) is optional for high churn serverless; avoid mixing confusion per env.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Public URL of the Next.js app (Better Auth base URL)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for Better Auth (min 32 chars in production)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Nest API
API_PORT=4000
# Next (web) URL — used for CORS and JWT JWKS verification
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000

# Web → Nest (browser and server)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Expo / mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_AUTH_URL=http://localhost:3000
